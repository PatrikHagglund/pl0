# Random e1-e6 program generator for differential fuzzing (docs/FUZZING.md).
# Compiles at -O3 with specialization on: the fork toolchain (see
# rules_koka/koka/private/repo.bzl) carries the two optimizer fixes that
# previously forced --fno-specialize and blocked the lvalue generator.
koka_binary(
    name = "efuzz",
    main = "efuzz.kk",
    srcs = ["efuzz.kk"],
    visibility = ["//visibility:public"],
)

# Export grammar files for runtime use
exports_files(glob(["*.peg"]))

# Export Koka files for tests
